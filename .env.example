# ----------------------------------------------------------------------
# LLM Provider configuration
# ----------------------------------------------------------------------
# Choose "groq", "gemini", or "openrouter" -- all have free tiers.
LLM_PROVIDER=groq

# Groq (FREE tier, https://console.groq.com)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL=openai/gpt-oss-20b


# Google Gemini (FREE standing tier, https://aistudio.google.com/apikey)
# Uses Google's official OpenAI-compatible endpoint, so no extra SDK needed.
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter (FREE models available, https://openrouter.ai)
# openrouter/free auto-selects a currently-live free model, so you don't
# have to chase individual :free model slugs as they get deprecated.
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL=openrouter/free

# ----------------------------------------------------------------------
# RAG tuning parameters (can also be changed live from the Streamlit UI)
# ----------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
EMBEDDING_MODEL=all-MiniLM-L6-v2
